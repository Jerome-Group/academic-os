{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:academic-os:module-head:1",
  "title": "ModuleHead",
  "properties": {
    "$schema": {
      "const": "urn:academic-os:module-head:1"
    },
    "schemaVersion": {
      "const": 1
    },
    "module": {
      "type": "string",
      "pattern": "^module:[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
    },
    "moduleCode": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}[0-9]{4}[A-Z]?$"
    },
    "contractVersion": {
      "const": 8
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "byteSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        }
      },
      "required": ["file", "schema", "byteSha256", "id"]
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "module",
    "moduleCode",
    "contractVersion",
    "generation"
  ]
}
