{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:academic-os:naming-request:1",
  "title": "NamingRequest",
  "properties": {
    "$schema": {
      "const": "urn:academic-os:naming-request:1"
    },
    "schemaVersion": {
      "const": 1
    },
    "policy": {
      "$ref": "urn:academic-os:naming-policy:1"
    },
    "module": {
      "$ref": "urn:academic-os:module-identity:1"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^artifact:[A-Za-z0-9][A-Za-z0-9:._-]*$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^source:[A-Za-z0-9][A-Za-z0-9:._-]*$"
              },
              "title": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                },
                "minItems": 1
              },
              "legacyIdentity": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "algorithm": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                        }
                      }
                    },
                    "required": ["algorithm", "value", "evidence"]
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "filename",
              "evidence",
              "legacyIdentity"
            ]
          },
          "acceptedBy": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
            },
            "minItems": 1
          },
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "enum": [
                  "lecture",
                  "personal-note",
                  "tutorial",
                  "quiz",
                  "test",
                  "midterm",
                  "final",
                  "assignment",
                  "project",
                  "lab",
                  "resource"
                ]
              },
              "directory": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                },
                "minItems": 1
              }
            },
            "required": ["category", "directory", "evidence"]
          },
          "titleTokens": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "sourceTokens": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "sequence": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "source"
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9]{1,2}$"
                  },
                  "format": {
                    "enum": ["preserve", "minimum-two"]
                  },
                  "authority": {
                    "enum": [
                      "source-title",
                      "source-filename",
                      "accepted-artifact-sequence"
                    ]
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                    },
                    "minItems": 1
                  }
                },
                "required": ["kind", "token", "format", "authority", "evidence"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "not-applicable"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                    },
                    "minItems": 1
                  }
                },
                "required": ["kind", "evidence"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "unknown"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                    },
                    "minItems": 1
                  }
                },
                "required": ["kind", "reason", "evidence"]
              }
            ]
          },
          "issued": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "day": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                    },
                    "minItems": 1
                  }
                },
                "required": ["day", "evidence"]
              },
              {
                "type": "null"
              }
            ]
          },
          "academicYear": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9]{4}(?:-[0-9]{4})?$"
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                    },
                    "minItems": 1
                  }
                },
                "required": ["value", "evidence"]
              },
              {
                "type": "null"
              }
            ]
          },
          "traits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {
                "enum": [
                  "questions",
                  "solutions",
                  "questions-and-solutions",
                  "other",
                  "unknown"
                ]
              },
              "annotation": {
                "enum": ["clean", "annotated", "unknown"]
              },
              "grading": {
                "enum": ["graded", "ungraded", "unknown"]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                },
                "minItems": 1
              }
            },
            "required": ["content", "annotation", "grading", "evidence"]
          },
          "representation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["file", "native-bundle"]
              },
              "role": {
                "enum": ["native", "editable", "rendered", "support", "unknown"]
              },
              "extension": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                },
                "minItems": 1
              }
            },
            "required": ["kind", "role", "extension", "evidence"]
          },
          "qualifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tokens": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                  },
                  "minItems": 1
                }
              },
              "required": ["tokens", "evidence"]
            },
            "minItems": 0
          },
          "disambiguators": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "source-id",
                    "source-version",
                    "year",
                    "date",
                    "edition"
                  ]
                },
                "tokens": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^evidence:[A-Za-z0-9][A-Za-z0-9:._-]*$"
                  },
                  "minItems": 1
                }
              },
              "required": ["kind", "tokens", "evidence"]
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "source",
          "acceptedBy",
          "destination",
          "titleTokens",
          "sourceTokens",
          "sequence",
          "issued",
          "academicYear",
          "traits",
          "representation",
          "qualifiers",
          "disambiguators"
        ]
      },
      "minItems": 0
    },
    "occupiedPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["file", "directory", "native-bundle"]
          }
        },
        "required": ["path", "kind"]
      },
      "minItems": 0
    },
    "targetContractVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "policy",
    "module",
    "artifacts",
    "occupiedPaths",
    "targetContractVersion"
  ]
}
