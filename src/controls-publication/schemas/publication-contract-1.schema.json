{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:academic-os:publication-contract:1",
  "title": "PublicationContract",
  "$ref": "#/definitions/JournalEvent",
  "definitions": {
    "ExpectedHead": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "required": ["kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "digest"
            },
            "headByteSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": ["kind", "headByteSha256"]
        }
      ]
    },
    "ModuleAggregate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "module"
        },
        "module": {
          "$ref": "urn:academic-os:module-identity:1#/properties/module"
        },
        "moduleCode": {
          "$ref": "urn:academic-os:module-identity:1#/properties/moduleCode"
        }
      },
      "required": ["kind", "module", "moduleCode"]
    },
    "ByteBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["byteLength", "byteSha256"]
    },
    "FrozenBytes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytesBase64": {
          "type": "string",
          "format": "publication-base64"
        }
      },
      "required": ["byteLength", "byteSha256", "bytesBase64"]
    },
    "ObjectIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["directory", "regular"]
        },
        "volumeUuid": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "inode": {
          "type": "string",
          "minLength": 1
        },
        "birthtimeNs": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["kind", "volumeUuid", "device", "inode", "birthtimeNs"]
    },
    "Location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "$ref": "#/definitions/ObjectIdentity"
        },
        "rawNameBase64": {
          "type": "string",
          "minLength": 4,
          "format": "publication-raw-name"
        }
      },
      "required": ["parent", "rawNameBase64"]
    },
    "MetadataObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "linkCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "aclBytesBase64": {
          "type": "string",
          "format": "publication-base64"
        },
        "localVolume": {
          "const": true
        }
      },
      "required": [
        "uid",
        "gid",
        "mode",
        "flags",
        "linkCount",
        "aclBytesBase64",
        "localVolume"
      ]
    },
    "PhysicalClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "$ref": "#/definitions/ObjectIdentity"
        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "metadata": {
          "$ref": "#/definitions/MetadataObservation"
        }
      },
      "required": ["object", "location", "metadata"]
    },
    "HostIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writerUid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "accountUuid": {
          "type": "string",
          "minLength": 1
        },
        "hostUuid": {
          "type": "string",
          "minLength": 1
        },
        "accountHomeDisplay": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "$ref": "#/definitions/ObjectIdentity"
        }
      },
      "required": [
        "writerUid",
        "accountUuid",
        "hostUuid",
        "accountHomeDisplay",
        "anchor"
      ]
    },
    "NamespaceReservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "namespace-reserved"
        },
        "host": {
          "$ref": "#/definitions/HostIdentity"
        },
        "ledger": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "target": {
          "$ref": "#/definitions/Location"
        },
        "policy": {
          "const": "generated-publication/1"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "host",
        "ledger",
        "target",
        "policy"
      ]
    },
    "NamespaceClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "namespace-claimed"
        },
        "host": {
          "$ref": "#/definitions/HostIdentity"
        },
        "ledger": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "namespace": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "reservationDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "host",
        "ledger",
        "namespace",
        "reservationDigest"
      ]
    },
    "CreateBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "identityBytes": {
          "$ref": "#/definitions/FrozenBytes"
        },
        "releaseDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effect": {
          "const": "private-generated-controls/1"
        }
      },
      "required": ["requestId", "identityBytes", "releaseDigest", "effect"]
    },
    "CandidateReservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "candidate-reserved"
        },
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "binding": {
          "$ref": "#/definitions/CreateBinding"
        },
        "aggregate": {
          "$ref": "#/definitions/ModuleAggregate"
        },
        "target": {
          "$ref": "#/definitions/Location"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "candidateId",
        "binding",
        "aggregate",
        "target"
      ]
    },
    "GeneratedCandidateAdmission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "generated-candidate-admitted"
        },
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "createBindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "aggregate": {
          "$ref": "#/definitions/ModuleAggregate"
        },
        "root": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "policy": {
          "const": "generated-publication/1"
        },
        "effect": {
          "const": "private-generated-controls/1"
        },
        "releaseDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "candidateId",
        "createBindingDigest",
        "aggregate",
        "root",
        "policy",
        "effect",
        "releaseDigest"
      ]
    },
    "ControlBytes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "urn:academic-os:control-generation:2#/properties/controls/items/properties/role"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "format": "publication-relative-path"
        },
        "bytes": {
          "$ref": "#/definitions/FrozenBytes"
        }
      },
      "required": ["role", "file", "bytes"]
    },
    "DependencyBytes": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "retained-original"
            },
            "evidenceId": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "format": "publication-relative-path"
            },
            "bytes": {
              "$ref": "#/definitions/FrozenBytes"
            }
          },
          "required": ["kind", "evidenceId", "path", "bytes"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "shared-preferences"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "format": "publication-relative-path"
            },
            "bytes": {
              "$ref": "#/definitions/FrozenBytes"
            }
          },
          "required": ["kind", "id", "version", "path", "bytes"]
        }
      ]
    },
    "PublicationBundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "const": "urn:academic-os:publication-bundle:1"
        },
        "schemaVersion": {
          "const": 1
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ControlBytes"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DependencyBytes"
          }
        },
        "nativeArtifactEffects": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      },
      "required": [
        "$schema",
        "schemaVersion",
        "controls",
        "dependencies",
        "nativeArtifactEffects"
      ]
    },
    "SelectedHead": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "selected"
        },
        "head": {
          "$ref": "#/definitions/FrozenBytes"
        },
        "headClaim": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "generationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "generationManifest": {
          "$ref": "#/definitions/ByteBinding"
        },
        "generationRoot": {
          "$ref": "#/definitions/PhysicalClaim"
        }
      },
      "required": [
        "kind",
        "head",
        "headClaim",
        "generationId",
        "generationManifest",
        "generationRoot"
      ]
    },
    "OwnedHead": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent"
            }
          },
          "required": ["kind"]
        },
        {
          "$ref": "#/definitions/SelectedHead"
        }
      ]
    },
    "PublishBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "inputBytes": {
          "$ref": "#/definitions/FrozenBytes"
        },
        "expectedHead": {
          "$ref": "#/definitions/ExpectedHead"
        },
        "releaseDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "effect": {
          "const": "private-generated-controls/1"
        }
      },
      "required": [
        "requestId",
        "candidateId",
        "inputBytes",
        "expectedHead",
        "releaseDigest",
        "effect"
      ]
    },
    "PlannedFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "format": "publication-relative-path"
        },
        "kind": {
          "enum": ["control", "generation", "head", "retained-input"]
        },
        "bytes": {
          "$ref": "#/definitions/FrozenBytes"
        }
      },
      "required": ["path", "kind", "bytes"]
    },
    "PublicationPlan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "publication-plan"
        },
        "encoding": {
          "const": "academic-os-publication-json/1"
        },
        "planId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "binding": {
          "$ref": "#/definitions/PublishBinding"
        },
        "aggregate": {
          "$ref": "#/definitions/ModuleAggregate"
        },
        "admissionByteSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root": {
          "$ref": "#/definitions/ObjectIdentity"
        },
        "previousHead": {
          "$ref": "#/definitions/OwnedHead"
        },
        "generationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PlannedFile"
          }
        },
        "nativeArtifactEffects": {
          "type": "array",
          "maxItems": 0,
          "items": false
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "encoding",
        "planId",
        "binding",
        "aggregate",
        "admissionByteSha256",
        "root",
        "previousHead",
        "generationId",
        "files",
        "nativeArtifactEffects"
      ]
    },
    "StageClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "stage-claimed"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "purpose": {
          "enum": ["candidate", "generation", "retained-input"]
        },
        "stage": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "finalLocation": {
          "$ref": "#/definitions/Location"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "purpose",
        "stage",
        "finalLocation"
      ]
    },
    "StageReservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "stage-reserved"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "purpose": {
          "enum": ["candidate", "generation", "retained-input"]
        },
        "stageLocation": {
          "$ref": "#/definitions/Location"
        },
        "finalLocation": {
          "$ref": "#/definitions/Location"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "purpose",
        "stageLocation",
        "finalLocation"
      ]
    },
    "TemporaryReservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "temporary-reserved"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "purpose": {
          "enum": ["head", "receipt"]
        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "planned": {
          "$ref": "#/definitions/ByteBinding"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "purpose",
        "location",
        "planned"
      ]
    },
    "FileClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "file-claimed"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "format": "publication-relative-path"
        },
        "file": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "planned": {
          "$ref": "#/definitions/ByteBinding"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "path",
        "file",
        "planned"
      ]
    },
    "DirectoryClaim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "directory-claimed"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "directory": {
          "$ref": "#/definitions/PhysicalClaim"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "directory"
      ]
    },
    "PromotionIntent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "promotion-intent"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "source": {
          "$ref": "#/definitions/PhysicalClaim"
        },
        "destination": {
          "$ref": "#/definitions/Location"
        },
        "destinationExpectation": {
          "const": "absent"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "source",
        "destination",
        "destinationExpectation"
      ]
    },
    "PromotionObserved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "promotion-observed"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "object": {
          "$ref": "#/definitions/ObjectIdentity"
        },
        "from": {
          "$ref": "#/definitions/Location"
        },
        "to": {
          "$ref": "#/definitions/Location"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "object",
        "from",
        "to"
      ]
    },
    "OrphanAttempt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "orphan-attempt"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "observedObject": {
          "$ref": "#/definitions/ObjectIdentity"
        },
        "reason": {
          "const": "creation-without-durable-claim"
        },
        "disposition": {
          "const": "retained-unadmitted"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "attemptId",
        "location",
        "observedObject",
        "reason",
        "disposition"
      ]
    },
    "HeadReady": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
