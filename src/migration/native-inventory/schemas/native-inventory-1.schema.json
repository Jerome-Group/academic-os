              "$ref": "urn:academic-os:native-scan-record:1#/$defs/acl"
            },
            {
              "type": "null"
            }
          ]
        },
        "xattrs": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "nameHex": {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{2})*$"
                  },
                  "payload": {
                    "anyOf": [
                      {
                        "$ref": "urn:academic-os:native-scan-record:1#/$defs/payload"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["nameHex", "payload"],
                "additionalProperties": false
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "hardlinkGroup": {
          "anyOf": [
