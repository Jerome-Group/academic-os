{
  "name": "@jerome-group/academic-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "academic-os": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "rule-coverage:check": "npm run build && node scripts/check-contract-rule-coverage.mjs",
    "templates:check": "node scripts/compile-seed-templates.mjs",
    "privacy:check": "npm run build && node --test dist/test/privacy/*.test.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run rule-coverage:check && npm run privacy:check"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "google-auth-library": "11.0.1",
    "yaml": "2.9.0"
  }
}
