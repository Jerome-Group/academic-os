  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "pathHex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        },
        "kind": {
          "enum": [
            "file",
            "directory",
            "symlink",
            "fifo",
            "character-device",
            "block-device",
            "socket",
            "unknown"
          ]
        },
        "before": {
          "$ref": "urn:academic-os:native-scan-record:1#/$defs/stat"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "urn:academic-os:native-scan-record:1#/$defs/stat"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
